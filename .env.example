NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Required for extension API access; never use NEXT_PUBLIC_ here.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Chrome's unpacked extension ID, comma-separated if needed
NEXT_PUBLIC_EXTENSION_IDS=
# Optional: absolute path to a host-provided Chromium executable for previews.
# Linux uses bundled serverless Chromium; macOS/Windows use Playwright Chromium.
TABD_CHROMIUM_PATH=
